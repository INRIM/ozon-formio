# =============================================================================
# ozon-app-web — configurazione ambiente
# Copia in .env e adatta i valori.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API
# URL del backend raggiungibile dal browser (dev) o dal container nginx (prod).
# In dev: http://localhost:7999
# In docker (interno): http://app:8000 o nome del servizio backend
# -----------------------------------------------------------------------------
BACKENDURL=http://localhost:7999

# URL pubblico del sito (usato per allowedOrigins e redirect sicuri)
# Lasciare vuoto in sviluppo locale.
SITE_URL=

# Origini CORS aggiuntive consentite (comma-separated), opzionale
# ALLOWED_ORIGINS=https://myapp.example.com,https://api.example.com

# -----------------------------------------------------------------------------
# Auth (keycloak) — percorsi endpoint relativi al backend
# Questi valori devono corrispondere a AUTH_LOGIN_PATH / AUTH_LOGOUT_PATH
# / AUTH_REFRESH_PATH definiti nel backend ozon-env-app.
# -----------------------------------------------------------------------------
AUTH_LOGIN_PATH=/api/login
AUTH_LOGOUT_PATH=/api/logout
AUTH_REFRESH_PATH=/api/auth/refresh

# Codice applicazione — usato come filtro tenant su tutte le chiamate backend
APP_CODE=

# Nome del modulo mostrato nell'header (brand title). Se vuoto, resta il default
# hardcoded lato frontend ('Mci Service') finché il backend non invia module_name.
APP_MODULE_NAME=

# -----------------------------------------------------------------------------
# Docker compose (dev mode — docker-compose.angular.yml)
# -----------------------------------------------------------------------------
# Rete Docker esterna a cui collegarsi (deve esistere o essere creata)
BACKEND_DOCKER_NETWORK=ozn-network

# Porta esposta dal container Angular dev server
OZON_ANGULAR_PORT=4200

# Immagine Node da usare nel container dev (opzionale)
# NODE_DOCKER_IMAGE=node:22-bookworm
NETWORK=