{
  "name": "ozon-client",
  "version": "5.0.1",
  "description": "A Form.io form viewer application for ozon",
  "main": "index.js",
  "scripts": {
    "build": "gulp build && webpack --config webpack.config.js && gulp inlinesource",
    "dist": "gulp build && webpack --config webpack.prod.js && gulp inlinesource",
    "dev": "gulp build && webpack --config webpack.config.js",
    "start": "node scripts/serve-dist.js",
    "start:angular": "npm --prefix ozon-app-web start",
    "start:angular:docker": "./scripts/angular-docker.sh start",
    "build:angular": "npm --prefix ozon-app-web run build",
    "build:angular:docker": "./scripts/angular-docker.sh build",
    "test:angular": "npm --prefix ozon-app-web run test",
    "test:angular:docker": "./scripts/angular-docker.sh test",
    "install:angular:docker": "./scripts/angular-docker.sh install",
    "watch": "watch 'npm run dev' ./src",
    "test": "npm run build && node scripts/smoke-test.js"
  },
  "author": "Alessio Gerace <a.gerace@inrim.it>",
  "license": "MIT",
  "dependencies": {
    "abortcontroller-polyfill": "^1.7.5",
    "bootstrap": "^5.3.2",
    "bootswatch": "^5.3.2",
    "choices": "^0.1.3",
    "core-js": "^3.32.0",
    "flatpickr": "^4.6.13",
    "font-awesome": "^4.7.0",
    "formiojs": "^5.0.0-rc.4",
    "moment": "^2.29.4",
    "seamless": "^1.4.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.9",
    "@babel/core": "^7.22.9",
    "@babel/plugin-proposal-export-default-from": "^7.22.5",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.22.9",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.2.3",
    "copy-props": "^3.0.1",
    "del": "^6.0.0",
    "gulp": "^5.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-eslint": "^6.0.0",
    "gulp-filter": "^6.0.0",
    "gulp-htmlmin": "^5.0.1",
    "gulp-inline-source": "^4.0.0",
    "gulp-load-plugins": "^2.0.7",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.4",
    "gulp-s3": "^0.2.0",
    "gulp-sass": "^5.1.0",
    "gulp-streamify": "^1.0.2",
    "gulp-uglify": "^3.0.2",
    "knox": "^0.5.0",
    "nth-check": "^2.1.1",
    "replace-string-loader": "^0.0.7",
    "string-replace-loader": "^3.1.0",
    "terser": "^5.39.0",
    "typescript": "^5.1.6",
    "vinyl-source-stream": "^2.0.0",
    "watch": "^0.13.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^4.9.1",
    "xml2js": "^0.6.2"
  }
}
