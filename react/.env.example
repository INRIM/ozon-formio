# Backend API reachable from the nginx container.
BACKENDURL=http://ozon-env-app:8000

# Public URL used by the browser and auth redirects.
SITE_URL=http://localhost:4200

# Auth endpoints exposed by the backend/proxy.
AUTH_LOGIN_PATH=/login
AUTH_LOGOUT_PATH=/logout
AUTH_REFRESH_PATH=/refresh

# Ozon tenant/application code.
APP_CODE=

# Docker compose.
BACKEND_DOCKER_NETWORK=ozn-network
OZON_REACT_PORT=4200
SESSION_CACHE_TTL_MS=30000
